{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "products.schema.json",
  "title": "Products",
  "type": "object",
  "required": ["products"],
  "properties": {
    "$schema": { "type": "string" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "slug", "type", "category", "title", "authors", "translators", "publisher", "isbn", "pages", "binding", "languages", "dimensions", "tradition", "saints", "seasons", "flags", "releaseDate", "availability", "formats", "art", "description"],
        "properties": {
          "id": { "$ref": "common.schema.json#/definitions/id" },
          "slug": { "$ref": "common.schema.json#/definitions/id", "description": "Last part of the product URL." },
          "type": { "enum": ["book", "music", "icon", "prayer-rope", "cross", "incense", "candle", "gift", "gift-card"] },
          "category": { "type": "string", "description": "Category id from categories.json." },
          "title": { "$ref": "common.schema.json#/definitions/localized" },
          "subtitle": { "$ref": "common.schema.json#/definitions/localized" },
          "authors": { "type": "array", "items": { "type": "string" }, "description": "Person ids from people.json." },
          "translators": { "type": "array", "items": { "type": "string" } },
          "publisher": { "type": ["string", "null"] },
          "isbn": { "type": ["string", "null"] },
          "pages": { "type": ["integer", "null"], "minimum": 1 },
          "binding": { "enum": ["hardcover", "paperback", "ebook", "audio", "cd", "item", "gift-card", null] },
          "languages": { "type": "array", "items": { "type": "string" }, "description": "Language codes of the text, such as en, ru, el, csl." },
          "dimensions": { "type": ["string", "null"] },
          "tradition": { "enum": ["patristic", "russian", "greek-athonite", "pan-orthodox"] },
          "saints": { "type": "array", "items": { "type": "string" } },
          "seasons": { "type": "array", "items": { "type": "string" } },
          "flags": { "type": "array", "items": { "enum": ["new", "staff-pick", "featured"] }, "uniqueItems": true },
          "releaseDate": { "$ref": "common.schema.json#/definitions/date" },
          "availability": { "enum": ["in_stock", "low_stock", "out_of_stock", "preorder"] },
          "formats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "format", "price"],
              "properties": {
                "id": { "type": "string" },
                "format": { "enum": ["hardcover", "paperback", "ebook", "audio", "cd", "item", "gift-card"] },
                "price": { "type": "number", "minimum": 0 },
                "label": { "$ref": "common.schema.json#/definitions/localized" }
              },
              "additionalProperties": false
            }
          },
          "art": {
            "type": "object",
            "description": "Drawn placeholder art. Replace with real photos by adding images later.",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["book", "audio", "icon", "prayer-rope", "cross", "incense", "candles", "gift", "bookmarks", "gift-card"] },
              "cloth": { "type": "string" },
              "design": { "enum": ["frame", "band", "panel", "medallion", "picture", "gospel"] },
              "emblem": { "type": "string" },
              "subject": { "enum": ["christ", "theotokos", "nicholas"] },
              "variant": { "enum": ["slavic", "byzantine", "icxc-nika"] },
              "knots": { "type": "integer" }
            },
            "additionalProperties": false
          },
          "staffNote": { "$ref": "common.schema.json#/definitions/localized" },
          "description": { "$ref": "common.schema.json#/definitions/localized" },
          "toc": { "type": "array", "items": { "$ref": "common.schema.json#/definitions/localized" } },
          "lookInside": { "type": ["object", "null"], "properties": { "images": { "type": "array", "items": { "type": "string" } } } },
          "specs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "value"],
              "properties": { "label": { "$ref": "common.schema.json#/definitions/localized" }, "value": { "$ref": "common.schema.json#/definitions/localized" } },
              "additionalProperties": false
            }
          },
          "reviews": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "rating", "text"],
              "properties": {
                "name": { "$ref": "common.schema.json#/definitions/localized" },
                "rating": { "type": "integer", "minimum": 1, "maximum": 5 },
                "text": { "$ref": "common.schema.json#/definitions/localized" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
